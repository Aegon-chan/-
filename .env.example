# =============================================================================
# 科研Agent 环境变量配置示例
# =============================================================================

# --- 应用配置 ---
APP_NAME=ResearchAgent
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- 数据库 ---
DATABASE_URL=sqlite:///./data/research_agent.db
# DATABASE_URL=postgresql://user:password@localhost:5432/research_agent

# --- AI 模型 API ---
# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com

# KIMI (Moonshot)
KIMI_API_KEY=your-kimi-api-key
KIMI_API_BASE=https://api.moonshot.cn

# OpenAI (备用)
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# --- 向量数据库 ---
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 沙箱配置 ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY=512

# --- 自我成长 ---
MEMORY_STORAGE_DIR=./data/memories
FEEDBACK_DB_PATH=./data/feedback.db
LORA_CHECKPOINT_DIR=./data/lora_checkpoints
BASE_MODEL_PATH=./model_cache/base_model

# --- Feature Flags ---
FEATURE_SELF_GROWTH=true
FEATURE_FEEDBACK=true
FEATURE_FINETUNE=false
FEATURE_REALTIME_REPORTS=true

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9090

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FILE=./data/logs/research_agent.log
