{% extends "base.html.j2" %}
{% block content %}
{% if sections %}
<div class="section">
<h2>今日监测概览</h2>
<div class="content">{{ sections[0].content | safe }}</div>
{% for chart in sections[0].get("charts", []) %}
<div class="chart-container">{{ chart | safe }}</div>
{% endfor %}
</div>
{% set sections = sections[1:] %}{% endif %}
{% for section in sections %}
<div class="section">
<h2>{{ section.title }}</h2>
<div class="content">{{ section.content | safe }}</div>
{% for chart in section.get("charts", []) %}
<div class="chart-container">{{ chart | safe }}</div>
{% endfor %}
{% for table in section.get("tables", []) %}
<table><thead><tr>{% for h in table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in table.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
{% endfor %}
</div>
{% endfor %}
{% endblock %}